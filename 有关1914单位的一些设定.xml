 <Worksheet ss:Name="交战规则">
  <Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="13" x:FullColumns="1"
   x:FullRows="1" ss:StyleID="s15" ss:DefaultColumnWidth="52"
   ss:DefaultRowHeight="14">
   <Column ss:Index="2" ss:StyleID="s15" ss:AutoFitWidth="0" ss:Width="509"/>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">单位仅能攻击或反击本单位射程范围内的格子</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">单位攻击其他单位时，受到双方各自受到对方攻击力的伤害，即攻击与反击</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">陆军无法攻击或反击空军</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="s20"><Data ss:Type="String">轰炸机仅能攻击陆军</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">非战斗机单位无法反击轰炸机</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">单位无法反击火炮</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">陆军单位无法反击空军</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">轰炸机无法反击</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">坦克默认具有坚守1，坚守上限提升至4</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="Number">10</Data></Cell>
    <Cell><Data ss:Type="String">工事效果每2防御力增加一次效果坚守1最多具有坚守2基础防御力最高为6</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="Number">11</Data></Cell>
    <Cell><Data ss:Type="String">结算顺序：有敌方巡逻时战斗机进攻随后陆军和轰炸机进攻</Data></Cell>
   </Row>
   <Row>
    <Cell ss:Index="2"><Data ss:Type="String">若没有敌方巡逻，即本回合没有空战空军和陆军统一结算</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="Number">12</Data></Cell>
    <Cell><Data ss:Type="String">工事可以被任何陆军开始建造且防御力上限为2</Data></Cell>
   </Row>
  </Table>
