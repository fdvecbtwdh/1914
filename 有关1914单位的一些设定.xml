 <Worksheet ss:Name="基础词条">
  <Table ss:ExpandedColumnCount="3" ss:ExpandedRowCount="22" x:FullColumns="1"
   x:FullRows="1" ss:StyleID="s15" ss:DefaultColumnWidth="52"
   ss:DefaultRowHeight="14">
   <Column ss:StyleID="s15" ss:AutoFitWidth="0" ss:Width="129.5"/>
   <Column ss:StyleID="s15" ss:AutoFitWidth="0" ss:Width="396.5"/>
   <Column ss:StyleID="s15" ss:AutoFitWidth="0" ss:Width="266"/>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">词条</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">效果</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">守护</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">为相邻友方单位添加具有本单位指向的“被守护”词条</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">被守护</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位受到周围八格部队造成的伤害时，视为攻击指向本单位的“守护”单位</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">响应</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位生产后可以在同一回合部署</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">突击</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位进入战场后可以直接操作</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">坚守</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位交战时，实际受到伤害=原伤害-“坚守”等级</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">坚守等级范围：1-3</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">潜行</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">敌方无法观察到本单位，直到“被发现”</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">被发现</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本“潜行”单位处于敌方步兵攻击范围内，可被敌方观察</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">前线无敌方单位时，友方单位具有“潜行”</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">防空</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位与空军交战时，可反击，且视为与射程范围内步兵交战</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">补给</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">友方回合开始时，本单位指向一个已受伤单位，将其修复</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">冲锋</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位首次攻击时，不受到反击伤害</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">收缴</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位消灭单位时，改为获得其50%生产所耗经济G</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">爆破</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位攻击时，同时对敌方单位所在阵线工事造成等同于爆破等级伤害</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">爆破等级范围：1-2</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">修复</Data></Cell>
    <Cell><Data ss:Type="String">具有修复效果时可恢复x点防御力</Data></Cell>
   </Row>
   <Row ss:Index="16">
    <Cell ss:StyleID="s16"><Data ss:Type="String">策反（先别端上来</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">本单位消灭敌方单位时，改为将一张复制加入手牌，视为金卡</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="s16"><Data ss:Type="String">掩护（炮兵炸鸡超模再端</Data></Cell>
    <Cell ss:StyleID="s16"><Data ss:Type="String">敌方炮兵或轰炸机无法攻击本单位</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">巡逻</Data></Cell>
    <Cell><Data ss:Type="String">战斗机可以执行巡逻任务自动进攻本战线的空军，执行后敌方空军可以主动攻击友方空军，如果不执行友方空军不会被锁定，巡逻需要在上回合结尾确认巡逻飞机</Data></Cell>
   </Row>
   <Row>
    <Cell ss:Index="2"><Data ss:Type="String">若在敌方战斗机进攻后仍有友方同一阵线的战斗机没有被进攻，自动进攻敌方剩余战斗机且不受反击伤害</Data></Cell>
   </Row>
   <Row ss:Index="21">
    <Cell><Data ss:Type="String">钳击</Data></Cell>
    <Cell><Data ss:Type="String">钳击单位入场时，选择一个友方单位成为钳击伙伴，双方同时具有钳击加成，其中一方离场时钳击伙伴失去钳击加成</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">工程</Data></Cell>
    <Cell><Data ss:Type="String">可以修筑提高工事防御力上限至6</Data></Cell>
   </Row>
  </Table>
